{
    "app-id": "org.lili.Fatbox",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "lili313",
    "finish-args": [
        "--share=network",
        "--device=all",
        "--filesystem=host"
    ],
    "modules": [
        {
            "name": "python3-offline",
            "buildsystem": "simple",
            "build-commands": [
                "./configure --prefix=/app --enable-optimizations --without-ensurepip",
                "make -j$(nproc)",
                "make altinstall",
                "ln -s /app/bin/python3.13 /app/bin/lili313"
            ],
            "sources": [
                {
                    "type": "archive",
                    "path": "/home/lawer22/Загрузки/Python-3.13.17.tar.xz"
                }
            ]
        }
    ]
}
